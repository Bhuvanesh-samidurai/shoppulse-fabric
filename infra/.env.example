# Copy to infra/.env (git-ignored). Never commit real values.
# Fabric identities are NOT here: each agent uses infra/secrets/sp-agent-<agent>.env
# (created by infra/bootstrap/bootstrap.ps1); CI uses GitHub secrets.

# Kaggle (Olist download). Use either the token, or username + key from kaggle.json.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# LLM enrichment for Silver reviews (Nebius, OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
NEBIUS_MODEL=

# Filled in later by DE1 (#3) once the items exist in the feature workspace
SQLDB_FEAT_CONNECTION_STRING=
EVENTSTREAM_FEAT_WMS_CONNECTION_STRING=
EVENTSTREAM_FEAT_CARRIER_CONNECTION_STRING=
