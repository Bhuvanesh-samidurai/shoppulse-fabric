# Copy to infra/.env (git-ignored). Never commit real values.

# Fabric (dev service principal only — agents never get test/prod credentials)
FABRIC_TENANT_ID=
FABRIC_DEV_CLIENT_ID=
FABRIC_DEV_CLIENT_SECRET=

# Fabric SQL Database (shop OLTP) per environment
SQLDB_DEV_CONNECTION_STRING=

# Eventstream custom endpoints (Event Hub compatible) per environment
EVENTSTREAM_DEV_WMS_CONNECTION_STRING=
EVENTSTREAM_DEV_CARRIER_CONNECTION_STRING=

# LLM enrichment (Silver reviews)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
NEBIUS_MODEL=

# Kaggle (Olist download)
KAGGLE_USERNAME=
KAGGLE_KEY=
